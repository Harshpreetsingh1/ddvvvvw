<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                👔 Employee Management System
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/employees">All Employees</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link btn btn-success btn-sm ms-2 text-white" href="/employees/create">
                            ➕ Add Employee
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <h1 class="mb-4">👤 Employee Details</h1>

                
                <% if (typeof successMessage !=='undefined' && successMessage) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        ✅ <%= successMessage %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                        
                        <div class="card mb-4">
                            <div class="card-header bg-primary text-white">
                                <h3 class="card-title mb-0">
                                    <%= employee.name %>
                                </h3>
                                <small>
                                    <%= employee.designation %>
                                </small>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <p><strong>Employee ID:</strong></p>
                                        <p class="text-muted">
                                            <%= employee.empId %>
                                        </p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Email:</strong></p>
                                        <p class="text-muted"><a href="mailto:<%= employee.email %>">
                                                <%= employee.email %>
                                            </a></p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <p><strong>Department:</strong></p>
                                        <p class="text-muted">
                                            <%= employee.department %>
                                        </p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Salary:</strong></p>
                                        <p class="text-muted">
                                            <span class="badge bg-success fs-6">₹<%= (employee.salary ||
                                                    0).toLocaleString() %></span>
                                        </p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <p><strong>Phone:</strong></p>
                                        <p class="text-muted"><a href="tel:<%= employee.phone %>">
                                                <%= employee.phone %>
                                            </a></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Joining Date:</strong></p>
                                        <p class="text-muted">
                                            <%= new Date(employee.joiningDate).toLocaleDateString('en-IN') %>
                                        </p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <p><strong>Address:</strong></p>
                                        <p class="text-muted">
                                            <%= employee.address %>, <%= employee.city %>, <%= employee.state %>
                                        </p>
                                    </div>
                                </div>

                                <hr>

                                <p class="text-muted small">
                                    <strong>Last Updated:</strong>
                                    <%= new Date(employee.updatedAt).toLocaleString('en-IN') %>
                                </p>
                            </div>
                        </div>

                        
                        <div class="d-flex gap-2 mt-4">
                            <a href="/employees/<%= employee._id %>/edit" class="btn btn-warning btn-lg">
                                ✏️ Edit Employee
                            </a>
                            <form action="/employees/<%= employee._id %>?_method=DELETE" method="POST"
                                style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-lg"
                                    onclick="return confirm('Are you sure you want to delete this employee?')">
                                    🗑️ Delete Employee
                                </button>
                            </form>
                            <a href="/employees" class="btn btn-secondary btn-lg">
                                ← Back to List
                            </a>
                        </div>
            </div>
        </div>
    </div>

    
    <footer class="bg-dark text-white text-center py-4 mt-5">
        <p class="mb-0">© 2026 Employee Management System | Built with Node.js, Express & MongoDB</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>
</body>

</html>
